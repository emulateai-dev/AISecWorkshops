OPENAI_API_KEY=****

## In case using Detoxio AI Key, you can uncomment the following.
OPENAI_BASE_URL=https://api.openai.com/v1/
#OPENAI_BASE_URL=https://api.detoxio.ai/dtx.services.llms.v1.LlmPlatformProxyService/openai/v1/

# Prompt-guard ("pg") service port. NOTE: 18000 is already used by Reaper
# (labs/setup/scripts/tools/install-reaper.sh) — do not change this back to
# 18000 or the two will collide if both are running on the same VM.
PG_PORT=18001

## DO NOT CHANGE
DTXPROMPT_GUARD_SVC_URL=http://pg:8000

## Concurrency
CONCURRENCY_LIMIT=1

# docker-compose env variables
DEMO_PORT=17860
DEMO_RAG_PORT=17861
DEMO_TOOL_AGENTS_PORT=17862
DEMO_TEXT2SQL_AGENTS_PORT=17863
OLLAMA_PORT=11436
CACHE_TTL=3600
CACHE_DIR=/tmp/cache
ENABLE_JAILBREAK_SECURITY=False

# Models to preload into this stack's own (isolated) Ollama instance.
# llama-guard3:1b-q3_K_S is also pulled by Pre_Installation.sh on the host —
# that's fine, they're separate Ollama data stores (see docker-compose.yml).
DOWNLOAD_OLLAMA_MODELS=llama-guard3:1b-q3_K_S
