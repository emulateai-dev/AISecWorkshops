# =====================================================================
# The Gauntlet — environment. Copy to .env:   cp .env.template .env
# Keys may come from EITHER this file OR your mounted ~/.secrets directory.
# =====================================================================

# --- Option A: put the Groq key directly here ---
GROQ_API_KEY=

# --- Option B: leave GROQ_API_KEY blank and mount your secrets dir;
#     the server then reads /secrets/GROQ_API_KEY.txt automatically. ---
SECRETS_DIR=/home/dtx/.secrets

# --- Server ---
GAUNTLET_PORT=8000

# --- Offline demo mode (no API key needed; deterministic mock target) ---
# GAUNTLET_MOCK=1
